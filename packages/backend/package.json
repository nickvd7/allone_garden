{
  "name": "allone_garden-backend",
  "version": "1.0.0",
  "description": "Backend server for AllOne Garden",
  "main": "src/index.js",
  "scripts": {
    "prestart": "node scripts/security-check.js",
    "start": "node src/index.js",
    "start:prod": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .js",
    "security-check": "node scripts/security-check.js",
    "db:setup": "node scripts/setup-db.js",
    "db:migrate": "node scripts/migrate-all.js",
    "db:dm": "node scripts/migrate-dm.js",
    "db:seed": "node scripts/seed.js",
    "db:gradendex": "node scripts/migrate-gradendex.js",
    "db:world": "node scripts/migrate-world.js",
    "db:proposals": "node scripts/migrate-proposals.js",
    "db:leaderboard-season": "node scripts/migrate-leaderboard-season-history.js",
    "db:push": "node scripts/migrate-push-tables.js"
  },
  "optionalDependencies": {
    "@sendgrid/mail": "^8.1.4",
    "better-sqlite3": "^9.4.3",
    "nodemailer": "^9.0.3"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.0.1",
    "google-auth-library": "^9.15.1",
    "helmet": "^7.1.0",
    "hyperswarm": "^4.7.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "redis": "^4.6.11",
    "socket.io": "^4.8.3",
    "validator": "^13.12.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "eslint": "^8.57.1",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
