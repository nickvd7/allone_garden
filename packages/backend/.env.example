# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# URL of the React frontend (used for CORS + Socket.IO origin whitelist)
FRONTEND_URL=http://localhost:3000

# Human-readable name shown to players (e.g. "Alice's Garden Server")
SERVER_NAME=AllOne Garden

# ── Database ───────────────────────────────────────────────────────────────────
# Leave empty to run in in-memory mode (no persistence, dev only)
DATABASE_URL=postgres://garden:changeme@localhost:5432/allone_garden

# ── Redis ──────────────────────────────────────────────────────────────────────
# Optional — only needed if you add Redis-backed rate limiting or pub-sub
REDIS_URL=redis://localhost:6379

# ── Authentication ─────────────────────────────────────────────────────────────
# REQUIRED in production — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Admin access ───────────────────────────────────────────────────────────────
# Comma-separated usernames that always have admin access (alternative to level=99 in DB)
# Example: ADMIN_USERS=alice,bob
ADMIN_USERS=

# ── P2P Federation ─────────────────────────────────────────────────────────────
# Set to true to join the Hyperswarm DHT and federate with other garden servers
P2P_ENABLED=false

# ── Plugin Marketplace ─────────────────────────────────────────────────────────
# URL of the community plugin registry (leave empty to disable marketplace browsing)
PLUGIN_REGISTRY_URL=
