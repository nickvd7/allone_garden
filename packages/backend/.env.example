# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# URL(s) of the React frontend (CORS + Socket.IO). Comma-separated for multiple origins.
# Example: https://app.example.com,https://www.example.com
FRONTEND_URL=http://localhost:3000

# Trust X-Forwarded-* from this many proxy hops (rate limit / audit IP accuracy). Example: 1 behind nginx.
# TRUST_PROXY=1

# Force plugins to declare explicit capabilities (also defaults to strict in NODE_ENV=production).
# PLUGIN_STRICT_CAPABILITIES=true

# Human-readable name shown to players (e.g. "Alice's Garden Server")
SERVER_NAME=AllOne Garden

# ── Database ───────────────────────────────────────────────────────────────────
# Leave empty to run in in-memory mode (no persistence, dev only)
DATABASE_URL=postgres://garden:changeme@localhost:5432/allone_garden

# ── Redis ──────────────────────────────────────────────────────────────────────
# Optional — only needed if you add Redis-backed rate limiting or pub-sub
REDIS_URL=redis://localhost:6379

# ── Authentication ─────────────────────────────────────────────────────────────
# REQUIRED in production — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Admin access ───────────────────────────────────────────────────────────────
# Comma-separated usernames that always have admin access (alternative to level=99 in DB)
# Example: ADMIN_USERS=alice,bob
ADMIN_USERS=

# ── P2P Federation ─────────────────────────────────────────────────────────────
# Set to true to join the Hyperswarm DHT and federate with other garden servers
P2P_ENABLED=false

# ── Email (password reset) ──────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email — reset tokens will be printed to stdout
# instead so the server admin can relay them to the user.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-app-password   (generate at myaccount.google.com → Security → App passwords)
#
# Any SMTP provider (Mailgun, Postmark, Resend, self-hosted) works the same way.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@allone.garden

# Public URL of the game (used in password-reset links sent by email)
APP_URL=http://localhost:3000

# ── Push notifications (mobile) ───────────────────────────────────────────────
# Optional: store device tokens via POST /api/push/register (requires auth).
# PUSH_USE_REDIS=true — persist tokens in Redis (needs REDIS_URL); else in-memory only.
# Admin broadcast: POST /api/admin/push/notify — prefer FCM HTTP v1:
#   FCM_SERVICE_ACCOUNT_JSON=<full JSON on one line>  OR  FCM_SERVICE_ACCOUNT_PATH=/path/to/firebase-adminsdk.json
#   FCM_PROJECT_ID=my-project   (optional if JSON contains project_id)
# Legacy: FCM_SERVER_KEY (Firebase Cloud Messaging server key)
# PUSH_USE_REDIS=false
#
# iOS native tokens (transport=apns): set APNs HTTP/2 credentials:
#   APNS_KEY_PATH=/path/to/AuthKey_XXXXXX.p8
#   APNS_KEY_ID=XXXXXXXXXX
#   APNS_TEAM_ID=XXXXXXXXXX
#   APNS_BUNDLE_ID=com.example.app
#   APNS_PRODUCTION=false   (true for App Store builds)
#
# Optional scheduled broadcast (node-cron): same title/body as admin notify
#   PUSH_SCHEDULE_CRON=0 9 * * *
#   PUSH_SCHEDULE_TITLE=Daily reminder
#   PUSH_SCHEDULE_BODY=Water your garden!

# ── Plugin Marketplace ─────────────────────────────────────────────────────────
# URL of the community plugin registry (leave empty to disable marketplace browsing)
PLUGIN_REGISTRY_URL=

# ── SQLite (Electron / offline desktop mode) ───────────────────────────────────
# Set to a file path to use SQLite for persistent storage without PostgreSQL.
# The Electron main process sets this automatically to userData/garden.db.
# Leave empty to use in-memory mode (data lost on restart).
SQLITE_PATH=

# ── Server identity ────────────────────────────────────────────────────────────
SERVER_MOTD=

# ── WebRTC ICE servers ─────────────────────────────────────────────────────────
# Override the default Google STUN servers or add a TURN server for NAT traversal.
# TURN is required for video calls across restrictive firewalls (corporate NAT).
WEBRTC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=
