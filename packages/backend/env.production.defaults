# Standaardwaarden voor productie — worden door scripts/merge-production-env.sh
# alleen toegevoegd als de sleutel nog niet in packages/backend/.env staat.
# Bestaande waarden (JWT, DATABASE_URL, …) worden nooit overschreven.

NODE_ENV=production
PORT=5000
TRUST_PROXY=1
PLUGIN_STRICT_CAPABILITIES=true
P2P_ENABLED=false
REDIS_URL=redis://localhost:6379
JWT_EXPIRES_IN=7d
