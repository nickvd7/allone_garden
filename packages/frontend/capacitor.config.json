{
  "appId": "com.allonegarden.app",
  "appName": "AllOne Garden",
  "webDir": "build",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#4caf50",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#388e3c"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    }
  }
}
