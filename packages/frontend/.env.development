# Local development API target.
#
# Leave REACT_APP_API_URL empty so the SPA uses relative paths (/api, /socket.io).
# These are forwarded to the backend by src/setupProxy.js, which tracks the
# BACKEND_PORT chosen by start.sh (5000, or 5001+ when 5000 is busy — e.g. macOS
# AirPlay Receiver occupies 5000). bash start.sh also sets REACT_APP_API_URL to
# the actual port, which takes precedence over this file when present.
#
# Do NOT hardcode http://localhost:5000 here: on macOS that port is AirPlay and
# silently breaks login/register when the backend has moved to 5001.
REACT_APP_API_URL=

# Wereldkaart: standaard DOM (2D-diepte). Pixi alleen met REACT_APP_PIXI_MAP=on of auto op Pi.
# REACT_APP_PIXI_MAP=on
