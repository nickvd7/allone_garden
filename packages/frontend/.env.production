# Automatisch geladen bij `npm run build` (Create React App).
# Lege API-URL = same-origin (/api, /socket.io) via nginx — standaard op allone.garden.
REACT_APP_API_URL=
REACT_APP_SERVER_NAME=AllOne Garden
# allone.garden en *.pages.dev tonen alleen de homepage. Login/register: under construction.
# Zet op false om het spel op het publieke domein weer aan te zetten.
# REACT_APP_HOMEPAGE_ONLY=false
