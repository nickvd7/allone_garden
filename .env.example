# ── AllOne Garden — Docker Compose environment ─────────────────────────────────
# Copy this file to .env and fill in the values before running docker compose up.

# REQUIRED: generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED: must be >= 32 chars and not a placeholder (generate with the command above)
JWT_SECRET=REPLACE_ME

# PostgreSQL password (used by both the db and backend containers)
POSTGRES_PASSWORD=REPLACE_ME

# Public URL where the frontend is reachable (used by backend CORS)
FRONTEND_URL=http://localhost:3000

# URL the browser uses to reach the backend API (baked into the React build)
FRONTEND_API_URL=http://localhost:5000

# Human-readable server name shown in the UI
SERVER_NAME=AllOne Garden

# Comma-separated admin usernames (no spaces)
ADMIN_USERS=

# Set to true to enable Hyperswarm P2P federation
P2P_ENABLED=false
